<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: title + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Appointment Details"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A"/>

            <TextView
                android:id="@+id/tvSecDetailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#854d0e"
                android:background="@drawable/bg_amber_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <!-- Patient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_purple_light_card"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PATIENT"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#7C3AED"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvSecDetailPatient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0F172A"/>
        </LinearLayout>

        <!-- Doctor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_green_light_card"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOCTOR"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvSecDetailDoctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0F172A"/>

            <TextView
                android:id="@+id/tvSecDetailSpec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Specialization"
                android:textSize="12sp"
                android:textColor="#059669"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Date + Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvSecDetailDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#334155"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvSecDetailTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#334155"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Reason for visit -->
        <LinearLayout
            android:id="@+id/layoutSecDetailReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_white"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REASON FOR VISIT"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSecDetailReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="13sp"
                android:textColor="#334155"
                android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressSecDetailAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="#7C3AED"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <!-- ── ACTION BUTTONS (PENDING or CONFIRMED) ─────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutSecDetailActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnSecDetailConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓  Confirm Appointment"
                android:textColor="#FFFFFF"
                android:backgroundTint="#059669"
                android:layout_marginBottom="8dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnSecDetailReject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✕  Reject"
                android:textColor="#FFFFFF"
                android:backgroundTint="#EF4444"
                android:layout_marginBottom="8dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnSecDetailCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✕  Cancel Appointment"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F59E0B"
                android:stateListAnimator="@null"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ── REJECT INPUT ──────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutSecRejectInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reason for Rejection (optional)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etSecRejectReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Slot unavailable, doctor on leave…"
                android:textSize="13sp"
                android:minLines="3"
                android:gravity="top"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp"
                android:inputType="textMultiLine"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSecRejectBack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Back"
                    android:textColor="#334155"
                    android:backgroundTint="#F1F5F9"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/btnSecRejectConfirm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Confirm Rejection"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#EF4444"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── CANCEL INPUT ──────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutSecCancelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reason for Cancellation (optional)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etSecCancelReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Doctor unavailable, patient no-show…"
                android:textSize="13sp"
                android:minLines="3"
                android:gravity="top"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp"
                android:inputType="textMultiLine"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSecCancelBack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Back"
                    android:textColor="#334155"
                    android:backgroundTint="#F1F5F9"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/btnSecCancelConfirm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Confirm Cancellation"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#F59E0B"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>