<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_green"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="40dp" android:layout_marginBottom="20dp">
            <Button android:id="@+id/btnBack" android:layout_width="wrap_content"
                android:layout_height="40dp" android:text="← Back" android:textColor="#10B981"
                android:textSize="13sp" android:background="@android:color/transparent" android:padding="0dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_background"
            android:padding="28dp" android:elevation="8dp" android:layout_marginBottom="32dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Doctor Registration" android:textColor="#0F172A"
                android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Join Our Medical Team"
                android:textColor="#94A3B8" android:textSize="13sp" android:layout_marginBottom="24dp"/>

            <TextView android:id="@+id/tvError" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#EF4444"
                android:textSize="13sp" android:background="@drawable/error_bg"
                android:padding="12dp" android:layout_marginBottom="16dp" android:visibility="gone"/>

            <!-- First Name -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="First Name *" android:textColor="#374151"
                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etFirstName" android:layout_width="match_parent"
                android:layout_height="52dp" android:hint="First name"
                android:inputType="textPersonName" android:background="@drawable/input_background"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="14sp"
                android:textColor="#0F172A" android:textColorHint="#94A3B8" android:layout_marginBottom="16dp"/>

            <!-- Last Name -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Last Name *" android:textColor="#374151"
                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etLastName" android:layout_width="match_parent"
                android:layout_height="52dp" android:hint="Last name"
                android:inputType="textPersonName" android:background="@drawable/input_background"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="14sp"
                android:textColor="#0F172A" android:textColorHint="#94A3B8" android:layout_marginBottom="16dp"/>

            <!-- Email -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Email Address *" android:textColor="#374151"
                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etEmail" android:layout_width="match_parent"
                android:layout_height="52dp" android:hint="your.email@example.com"
                android:inputType="textEmailAddress" android:background="@drawable/input_background"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="14sp"
                android:textColor="#0F172A" android:textColorHint="#94A3B8" android:layout_marginBottom="16dp"/>

            <!-- Phone -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Phone Number" android:textColor="#374151"
                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etPhone" android:layout_width="match_parent"
                android:layout_height="52dp" android:hint="+63 9xx xxx xxxx"
                android:inputType="phone" android:background="@drawable/input_background"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="14sp"
                android:textColor="#0F172A" android:textColorHint="#94A3B8" android:layout_marginBottom="16dp"/>

            <!-- Specialization -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Specialization *" android:textColor="#374151"
                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spinnerSpecialization" android:layout_width="match_parent"
                android:layout_height="52dp" android:background="@drawable/input_background"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginBottom="16dp"/>

            <!-- License Number -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Medical License No. *" android:textColor="#374151"
                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etLicenseNumber" android:layout_width="match_parent"
                android:layout_height="52dp" android:hint="e.g. MD123456"
                android:inputType="text" android:background="@drawable/input_background"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="14sp"
                android:textColor="#0F172A" android:textColorHint="#94A3B8" android:layout_marginBottom="16dp"/>

            <!-- Password -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Password *" android:textColor="#374151"
                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etPassword" android:layout_width="match_parent"
                android:layout_height="52dp" android:hint="Min. 8 characters"
                android:inputType="textPassword" android:background="@drawable/input_background"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="14sp"
                android:textColor="#0F172A" android:textColorHint="#94A3B8" android:layout_marginBottom="16dp"/>

            <!-- Confirm Password -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Confirm Password *" android:textColor="#374151"
                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etConfirmPassword" android:layout_width="match_parent"
                android:layout_height="52dp" android:hint="Repeat password"
                android:inputType="textPassword" android:background="@drawable/input_background"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="14sp"
                android:textColor="#0F172A" android:textColorHint="#94A3B8" android:layout_marginBottom="24dp"/>

            <!-- Notice -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/icon_bg_green" android:padding="12dp" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⏳  Your account requires Admin approval before login"
                    android:textColor="#059669" android:textSize="13sp"/>
            </LinearLayout>

            <Button android:id="@+id/btnRegister" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="Create Doctor Account →"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/button_green"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>