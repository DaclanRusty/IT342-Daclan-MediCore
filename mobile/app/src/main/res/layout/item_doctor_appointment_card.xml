<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:layout_marginEnd="12dp">
                <TextView android:id="@+id/tvDoctorApptInitials" android:layout_width="46dp" android:layout_height="46dp"
                    android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/bg_avatar_green"/>
                <ImageView android:id="@+id/ivDoctorApptPic" android:layout_width="46dp" android:layout_height="46dp"
                    android:scaleType="centerCrop" android:clipToOutline="true" android:background="@drawable/bg_avatar_green" android:visibility="gone"/>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvDoctorApptPatientName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#0F172A" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/tvDoctorApptReason" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12.5sp" android:textColor="#64748B" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/tvDoctorApptBookedAt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="#94A3B8" android:layout_marginTop="3dp" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/tvDoctorApptStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textStyle="bold" android:paddingStart="9dp" android:paddingEnd="9dp"
                android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginStart="8dp"
                android:background="@drawable/badge_confirmed" android:textColor="#059669"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_calendar" android:tint="#64748B" android:layout_marginEnd="4dp"/>
            <TextView android:id="@+id/tvDoctorApptDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
            <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_clock" android:tint="#64748B" android:layout_marginStart="10dp" android:layout_marginEnd="4dp"/>
            <TextView android:id="@+id/tvDoctorApptTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
        </LinearLayout>
        <TextView android:id="@+id/tvDoctorApptNotes" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#2563EB" android:background="@drawable/badge_completed"
            android:padding="8dp" android:layout_marginBottom="8dp" android:visibility="gone"/>
        <TextView android:id="@+id/tvDoctorApptCancelReason" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#64748B" android:background="@drawable/badge_cancelled"
            android:padding="8dp" android:layout_marginBottom="8dp" android:visibility="gone"/>
        <LinearLayout android:id="@+id/layoutApptActions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone">
            <Button android:id="@+id/btnCompleteAppt" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                android:text="✓ Complete" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_green" android:stateListAnimator="@null" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnCancelAppt" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                android:text="✕ Cancel" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_red" android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>