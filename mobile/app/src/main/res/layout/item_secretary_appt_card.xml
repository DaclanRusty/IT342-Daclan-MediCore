<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/viewSecApptAccent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:minHeight="80dp"
        android:background="#7C3AED"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/ivSecApptPatientPic"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:background="@drawable/bg_purple_circle"/>

                <TextView
                    android:id="@+id/tvSecApptInitials"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="P"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_purple_circle"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PATIENT"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:letterSpacing="0.06"/>

                <TextView
                    android:id="@+id/tvSecApptPatientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient Name"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSecApptStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#854d0e"
                android:background="@drawable/bg_amber_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOCTOR"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tvSecApptDoctorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Name"
                android:textSize="13sp"
                android:textColor="#334155"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSecApptDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jan 1, 2025"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvSecApptTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00 AM"
                android:textSize="12sp"
                android:textColor="#64748B"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View →"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#7C3AED"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>