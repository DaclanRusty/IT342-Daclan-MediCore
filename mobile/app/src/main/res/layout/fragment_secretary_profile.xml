<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressSecProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="#7C3AED"
            android:visibility="visible"/>

        <!-- ── VIEW MODE ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutSecProfileView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Avatar + name card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginBottom="12dp">

                <!-- Avatar with camera overlay -->
                <FrameLayout
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvSecProfileInitials"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:text="DB"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_purple_circle"/>

                    <ImageView
                        android:id="@+id/ivSecProfileAvatar"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:background="@drawable/bg_purple_circle"/>

                    <!-- Camera icon badge -->
                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_camera"
                            android:tint="#64748B"/>
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvSecProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Secretary Name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvSecProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="email@example.com"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginBottom="10dp"/>

                <!-- Role + Status badges -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Secretary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#7C3AED"
                        android:background="@drawable/bg_purple_pill"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/tvSecProfileStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APPROVED"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#059669"
                        android:background="@drawable/bg_green_pill"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                </LinearLayout>

                <!-- Edit Profile button -->
                <Button
                    android:id="@+id/btnSecEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✏  Edit Profile"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#7C3AED"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- Personal Information card -->
            <!-- Reordered to: Full Name → Email Address → Phone Number (matching web UI) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤  Personal Information"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginBottom="14dp"/>

                <!-- Full Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/border_bottom_light">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FULL NAME"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvSecProfileFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Secretary Name"
                        android:textSize="14sp"
                        android:textColor="#334155"/>
                </LinearLayout>

                <!-- Email Address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/border_bottom_light">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMAIL ADDRESS"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvSecProfileEmailInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="14sp"
                        android:textColor="#334155"/>
                </LinearLayout>

                <!-- Phone Number -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHONE NUMBER"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvSecProfilePhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not provided"
                        android:textSize="14sp"
                        android:textColor="#334155"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Assigned Doctor card — visible by default (matching web UI) -->
            <LinearLayout
                android:id="@+id/layoutSecAssignedDoctor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginBottom="12dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🩺  Assigned Doctor"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_purple_light_card">

                    <FrameLayout
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:id="@+id/tvSecAssignedDoctorInitials"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:text="JT"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_green_circle"/>

                        <ImageView
                            android:id="@+id/ivSecAssignedDoctorPic"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:background="@drawable/bg_green_circle"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSecAssignedDoctorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dr. Name"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A"/>

                        <TextView
                            android:id="@+id/tvSecAssignedDoctorSpec"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Specialization"
                            android:textSize="12sp"
                            android:textColor="#059669"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Account Security card — NEW (matching web UI) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginBottom="12dp">

                <!-- Lock icon box -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_gray_rounded"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lock"
                        android:tint="#7C3AED"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Security"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#334155"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your account is secured via Google OAuth or JWT authentication."
                        android:textSize="12sp"
                        android:textColor="#94A3B8"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
        <!-- end VIEW MODE -->

        <!-- ── EDIT MODE ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutSecProfileEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card_white"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Profile"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginBottom="16dp"/>

            <!-- Error banner -->
            <TextView
                android:id="@+id/tvSecSaveError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="#991B1B"
                android:background="@drawable/bg_red_light"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <!-- First Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First Name"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etSecFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="First name"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="14dp"
                android:inputType="textPersonName"/>

            <!-- Last Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Name"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etSecLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Last name"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="14dp"
                android:inputType="textPersonName"/>

            <!-- Phone Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etSecPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="+63 000 000 0000"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="14dp"
                android:inputType="phone"/>

            <!-- Email Address (read-only) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvSecEditEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="14sp"
                android:textColor="#94A3B8"
                android:textStyle="italic"
                android:padding="12dp"
                android:background="@drawable/bg_input_disabled"
                android:layout_marginBottom="20dp"/>

            <!-- Cancel / Save buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnSecCancelEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textColor="#334155"
                    android:backgroundTint="#F1F5F9"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/btnSecSaveProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save Changes"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#7C3AED"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressSecSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="#7C3AED"
                android:visibility="gone"/>

        </LinearLayout>
        <!-- end EDIT MODE -->

    </LinearLayout>
</ScrollView>