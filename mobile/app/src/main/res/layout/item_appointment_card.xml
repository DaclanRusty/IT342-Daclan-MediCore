<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#D9FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Accent Border -->
        <View
            android:id="@+id/viewAccentBorder"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/blue" />

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp">

                <TextView
                    android:id="@+id/tvDoctorInitials"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="DR"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/circle_avatar_bg" />

                <ImageView
                    android:id="@+id/ivDoctorPic"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvApptDoctorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Sample Doctor"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tvApptSpec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cardiologist"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp" />

                <!-- Date Time -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvApptDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="May 25"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/tvApptTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:00 AM"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBookedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booked recently"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvApptReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvApptStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PENDING"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#854D0E"
                    android:background="@drawable/badge_pending"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />


                <TextView
                    android:id="@+id/tvApptSubLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#F59E0B"
                    android:layout_marginTop="5dp"
                    android:gravity="end"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to view →"
                    android:textSize="10sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>