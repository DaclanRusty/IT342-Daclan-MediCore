<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <FrameLayout android:layout_width="50dp" android:layout_height="50dp" android:layout_marginEnd="12dp">
                <TextView android:id="@+id/tvSecCardInitials" android:layout_width="50dp" android:layout_height="50dp"
                    android:gravity="center" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/circle_avatar_bg"/>
                <ImageView android:id="@+id/ivSecCardPic" android:layout_width="50dp" android:layout_height="50dp"
                    android:scaleType="centerCrop" android:clipToOutline="true" android:background="@drawable/circle_avatar_bg" android:visibility="gone"/>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvSecCardName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#0F172A"/>
                <TextView android:id="@+id/tvSecCardEmail" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12.5sp" android:textColor="#64748B" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/tvSecCardPhone" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#94A3B8" android:layout_marginTop="2dp" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/tvSecCardStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textStyle="bold" android:paddingStart="9dp" android:paddingEnd="9dp"
                android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/badge_pending" android:textColor="#854D0E"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/layoutSecCardActions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone">
            <Button android:id="@+id/btnApproveSecretary" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                android:text="✓ Approve" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_green" android:stateListAnimator="@null" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnRejectSecretary" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                android:text="✕ Reject" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_red" android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>