<?xml version="1.0" encoding="utf-8"?>
<!--
  Mirrors AppointmentDetailModal.jsx:
  • Gradient header (color by status) with avatar + name + spec + status pill
  • Body: Date/Time grid, Reason block, dynamic status sections
    (COMPLETED=notes, CANCELLED=cancel info, REJECTED=rejection, CONFIRMED=confirm, PENDING=pending)
  • Close button at bottom
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ══════════════════════════════════════
         HEADER — gradient bg set in code
         ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp"
        android:background="@drawable/bg_header_default">

        <!-- Doctor row: avatar + name/spec -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="13dp">

                <TextView
                    android:id="@+id/tvDetailInitials"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/circle_avatar_bg" />

                <ImageView
                    android:id="@+id/ivDetailDoctorPic"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="@drawable/circle_avatar_bg"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Name + spec -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APPOINTMENT DETAILS"
                    android:textSize="10.5sp"
                    android:textColor="#BFffffff"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvDetailDoctorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:lineSpacingMultiplier="1.2" />

                <TextView
                    android:id="@+id/tvDetailSpec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="#CCffffff"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status pill — white translucent bg -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Use corners via GradientDrawable set in code; fallback shape below -->
            <TextView
                android:id="@+id/tvDetailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:letterSpacing="0.02" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════
         BODY — scrollable
         ══════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Date + Time grid (2 columns) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <!-- Date block -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_info_block"
                    android:padding="12dp"
                    android:layout_marginEnd="5dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="5dp">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="@color/slate_xl"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DATE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_xl"
                            android:letterSpacing="0.06" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/slate_m" />
                </LinearLayout>

                <!-- Time block -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_info_block"
                    android:padding="12dp"
                    android:layout_marginStart="5dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="5dp">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_clock"
                            android:tint="@color/slate_xl"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TIME"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_xl"
                            android:letterSpacing="0.06" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/slate_m" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Reason for Visit ── -->
            <LinearLayout
                android:id="@+id/layoutDetailReasonSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_info_block"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REASON FOR VISIT"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_xl"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDetailReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textColor="@color/slate_m"
                    android:lineSpacingMultiplier="1.65" />
            </LinearLayout>

            <!-- ── COMPLETED: Consultation Summary ── -->
            <LinearLayout
                android:id="@+id/layoutDetailNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_notes_block"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <!-- Header row: icon + title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:text="📋"
                        android:background="@drawable/bg_stat_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONSULTATION SUMMARY"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Doctor's notes from your visit"
                            android:textSize="10.5sp"
                            android:textColor="#FF3B82F6" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textColor="#FF1E3A8A"
                    android:lineSpacingMultiplier="1.75" />

                <TextView
                    android:id="@+id/tvDetailCompletedAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#FF3B82F6"
                    android:layout_marginTop="10dp"
                    android:paddingTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── CANCELLED: Cancellation Details ── -->
            <LinearLayout
                android:id="@+id/layoutDetailCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_cancel_block"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:text="✕"
                        android:textColor="@color/slate_l"
                        android:background="#14000000" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/tvCancelTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CANCELLATION DETAILS"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_l" />

                        <TextView
                            android:id="@+id/tvCancelledBy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/slate_l"
                            android:alpha="0.8" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailCancelReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textColor="@color/slate_l"
                    android:lineSpacingMultiplier="1.7" />

                <TextView
                    android:id="@+id/tvDetailCancelledAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_l"
                    android:alpha="0.8"
                    android:layout_marginTop="10dp"
                    android:paddingTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── REJECTED: Rejection Details ── -->
            <LinearLayout
                android:id="@+id/layoutDetailReject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_reject_block"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:text="✕"
                        android:textColor="@color/red"
                        android:background="#26EF4444" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="APPOINTMENT NOT APPROVED"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/red" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Declined by clinic secretary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/red"
                            android:alpha="0.75" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailRejectReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textColor="#FF991B1B"
                    android:lineSpacingMultiplier="1.7" />

                <TextView
                    android:id="@+id/tvDetailRejectedAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#FF991B1B"
                    android:alpha="0.8"
                    android:layout_marginTop="10dp"
                    android:paddingTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── CONFIRMED: confirmation banner ── -->
            <LinearLayout
                android:id="@+id/layoutDetailConfirmed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_confirmed_blocked"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅"
                    android:textSize="20sp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Appointment Confirmed"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Please arrive on time for your scheduled visit."
                        android:textSize="12sp"
                        android:textColor="#FF047857"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── PENDING: awaiting confirmation banner ── -->
            <LinearLayout
                android:id="@+id/layoutDetailPending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_pending_blocked"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳"
                    android:textSize="20sp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Awaiting Confirmation"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/amber_dk" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The clinic secretary will review and confirm your appointment."
                        android:textSize="12sp"
                        android:textColor="@color/amber_dk"
                        android:alpha="0.8"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Booked at timestamp -->
            <TextView
                android:id="@+id/tvDetailBookedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/slate_xl"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>